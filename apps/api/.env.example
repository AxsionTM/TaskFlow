DATABASE_URL=postgresql://ticktick:ticktick_secret@localhost:5432/ticktick
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-change-in-production
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=attachments
AI_SERVICE_URL=http://localhost:8000
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# SMTP для писем подтверждения почты и восстановления пароля
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=TaskFlow <no-reply@example.com>
# Cloudflare Turnstile (anti-bot для регистрации). Без секрета капча
# не проверяется (только dev); в production задайте оба значения.
TURNSTILE_SECRET_KEY=
# LLM для AI-агента (OpenAI-совместимый API). Без ключа агент работает
# в детерминированном rule-based режиме (все действия реальны).
# AI_LLM_URL=https://api.openai.com/v1/chat/completions
# AI_LLM_MODEL=gpt-4o-mini
AI_LLM_KEY=
# Anti-abuse лимиты регистрации (можно менять без переписывания логики)
REG_MAX_PER_HOUR_IP=10
REG_MAX_EMAILS_PER_HOUR_IP=10
REG_MIN_INTERVAL_SEC=20
REG_PENDING_TTL_MIN=30
REG_MIN_VERIFY_DELAY_SEC=3
REG_SIGNAL_RETENTION_HOURS=24
