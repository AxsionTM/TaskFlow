generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  locale        String    @default("ru")
  theme         String    @default("system")
  birthday      DateTime? // date of birth (year optional for display)
  // Email verification: existing users default to true (grandfathered),
  // newly registered users are created with false until they confirm the code.
  emailVerified Boolean   @default(true)
  emailVerifiedAt DateTime?
  // Admin: role USER|ADMIN, blocking, balance (native units), plan FREE|PRO|BUSINESS.
  role          String    @default("USER")
  isBlocked     Boolean   @default(false)
  balance       Float     @default(0)
  plan          String    @default("FREE")
  planStartedAt DateTime?
  planExpiresAt DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  birthdays    Birthday[]
  sessions      Session[]
  projects      ProjectMember[]
  tasks         Task[]           @relation("TaskAssignee")
  createdTasks  Task[]           @relation("TaskCreator")
  tags          Tag[]
  habits        Habit[]
  goals         Goal[]
  smartLists    SmartList[]
  focusSessions FocusSession[]
  notifications Notification[]
  subscriptions Subscription[]
  transactions  Transaction[]

  @@map("users")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

// Движение средств. Баланс меняется ТОЛЬКО вместе с созданием транзакции
// (атомарно в коде через $transaction).
model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  description   String?
  status        TransactionStatus @default(COMPLETED)
  adminId       String?
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("transactions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// История тарифов пользователя. Активная подписка = ACTIVE с endsAt в будущем
// (FREE без срока считается активной по умолчанию).
model Subscription {
  id            String             @id @default(cuid())
  userId        String
  plan          String
  price         Float              @default(0)
  startedAt     DateTime           @default(now())
  endsAt        DateTime?
  status        SubscriptionStatus @default(ACTIVE)
  paymentMethod String?
  transactionId String?
  createdBy     String?
  createdAt     DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, endsAt])
  @@map("subscriptions")
}

// Журнал действий администраторов.
model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  adminEmail   String
  action       String
  targetUserId String?
  description  String?
  oldValue     String?
  newValue     String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_logs")
}

enum VerificationPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Одноразовые коды подтверждения (email verify / password reset).
// Сам код хранится только в виде sha256-хэша, живёт 15 минут,
// после 5 неудачных попыток или успешного использования инвалидируется.
model VerificationCode {
  id        String              @id @default(cuid())
  email     String
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int                 @default(0)
  consumedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([email, purpose, createdAt])
  @@map("verification_codes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#4A90D9")
  icon        String?
  isInbox     Boolean  @default(false)
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]
  sections    Section[]
  tasks       Task[]
  tags        Tag[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("sections")
}

model Task {
  id              String         @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus     @default(TODO)
  priority        Priority       @default(NONE)
  dueDate         DateTime?
  startDate       DateTime?
  completedAt     DateTime?
  isAllDay        Boolean        @default(true)
  sortOrder       Int            @default(0)
  parentId        String?
  projectId       String?
  sectionId       String?
  creatorId       String
  assigneeId      String?
  recurrenceType  RecurrenceType @default(NONE)
  recurrenceRule  String?
  estimatedMinutes Int?
  actualMinutes   Int?
  isArchived      Boolean        @default(false)
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  parent    Task?     @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children  Task[]    @relation("SubTasks")
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section   Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator   User      @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  tags      TaskTag[]
  checklist ChecklistItem[]
  attachments Attachment[]
  reminders Reminder[]
  comments  Comment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@index([parentId])
  @@map("tasks")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#808080")
  icon      String?
  userId    String
  projectId String?
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks   TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Reminder {
  id        String   @id @default(cuid())
  taskId    String
  remindAt  DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Habit {
  id          String         @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String         @default("#4A90D9")
  icon        String?
  frequency   HabitFrequency @default(DAILY)
  targetDays  Int[]
  targetCount Int            @default(1)
  reminderTime String?
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs    HabitLog[]
  goals   GoalHabit[]

  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  count     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_logs")
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  targetValue Float?
  currentValue Float   @default(0)
  unit        String?
  deadline    DateTime?
  color       String   @default("#4A90D9")
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits GoalHabit[]
  tasks  GoalTask[]

  @@map("goals")
}

model GoalHabit {
  goalId  String
  habitId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([goalId, habitId])
  @@map("goal_habits")
}

model GoalTask {
  goalId String
  taskId String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([goalId, taskId])
  @@map("goal_tasks")
}

model SmartList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filter    Json
  icon      String?
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("smart_lists")
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  taskId      String?
  durationMin Int
  type        String   @default("pomodoro")
  startedAt   DateTime
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("focus_sessions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}


model Birthday {
  id        String   @id @default(cuid())
  userId    String
  name      String
  date      DateTime // month/day used; year for age
  note      String?
  remindDays Int     @default(0) // 0 = on the day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("birthdays")
}
